<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- Top bar -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa"
            android:textColor="@color/text_border_t100"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreate"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_button_primary"
            android:text="Tạo"
            android:layout_marginVertical="10dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <!-- Vùng preview: nền caro + ảnh pinch-zoom/pan -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintDimensionRatio="1:0.8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack">

            <com.jetpack.stickify.presentation.ui.edit_sticker.ZoomableStickerView
                android:id="@+id/zoomableView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/progressBar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_loading.json"
                app:lottie_loop="true" />

            <LinearLayout
                android:id="@+id/undoRedoGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_pill_white"
                android:elevation="4dp"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_undo"
                    app:tint="@color/text_border_t100" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_redo"
                    app:tint="@color/text_border_t100" />

            </LinearLayout>

        </FrameLayout>

        <!-- Ô nhập tạo sticker động bằng AI (placeholder, chưa nối backend) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/promptCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previewContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <!-- Icon lấp lánh (sparkles) bên trái -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_spark"
                    app:tint="#F2E683" />

                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:background="@android:color/transparent"
                    android:hint="Tạo sticker động, chỉ với vài dòng..."
                    android:inputType="textMultiLine"
                    android:maxLines="5"
                    android:textColorHint="#888888"
                    android:textSize="14sp" />

                <!-- Nút gửi màu xanh -->
                <ImageButton
                    android:id="@+id/btnSendPrompt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_primary"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <!-- Thay thế HorizontalScrollView và LinearLayout cũ bằng Custom View -->
        <com.jetpack.stickify.presentation.ui.edit_sticker.custom_view.EditorPanelView
            android:id="@+id/editorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/promptCard" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/featureScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/editorPanel">

            <FrameLayout
                android:id="@+id/featureContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp" />

        </androidx.core.widget.NestedScrollView>

        <!-- Lớp phủ tối khi AI đang tạo sticker.
             elevation (5dp) < promptCard (6dp) nên promptCard vẫn nằm trên và giữ nguyên.
             clickable để chặn mọi thao tác phía dưới. -->
        <FrameLayout
            android:id="@+id/aiLoadingOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#B3000000"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/aiLoadingLottie"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                app:lottie_fileName="anim_loading.json"
                app:lottie_loop="true" />

        </FrameLayout>

        <!-- Quầng sáng sóng biển nhòe ra ngoài promptCard.
             Cùng parent với promptCard, elevation 5.5dp: trên lớp phủ tối (5dp), dưới card (6dp). -->
        <com.jetpack.stickify.presentation.ui.edit_sticker.prompt_sticker.AiGlowHaloView

            android:id="@+id/aiGlowHalo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="5.5dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/addTextLayout"
            layout="@layout/layout_add_text" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>