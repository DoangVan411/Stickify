<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

        <!-- Top bar -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa"
            android:textSize="16sp"
            android:textColor="@color/text_border_t100"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Tạo"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button_primary"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Vùng preview: nền caro + ảnh pinch-zoom/pan -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintDimensionRatio="1:0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.jetpack.stickify.presentation.ui.edit_sticker.ZoomableStickerView
                android:id="@+id/zoomableView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/progressBar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:lottie_fileName="anim_loading.json"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/undoRedoGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill_white"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:elevation="4dp">

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_undo"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    app:tint="@color/text_border_t100" />

                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="44dp"
                    android:layout_height="38dp"
                    android:scaleType="fitCenter"
                    android:padding="6dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_redo"
                    app:tint="@color/text_border_t100"
                    />

            </LinearLayout>

        </FrameLayout>

        <!-- Ô nhập tạo sticker động bằng AI (placeholder, chưa nối backend) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/promptCard"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previewContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <!-- Icon lấp lánh (sparkles) bên trái -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_spark"
                    app:tint="#F2E683" /> <!-- Thay tên icon theo project của bạn -->

                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Tạo sticker động, chỉ với vài dòng..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColorHint="#888888"
                    android:textSize="14sp" />

                <!-- Nút gửi màu xanh -->
                <ImageButton
                    android:id="@+id/btnSendPrompt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_primary"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:src="@drawable/ic_send" /> <!-- Bạn nên dùng icon máy bay giấy màu trắng -->

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Thay thế HorizontalScrollView và LinearLayout cũ bằng Custom View -->
        <com.jetpack.stickify.presentation.ui.edit_sticker.custom_view.EditorPanelView
            android:id="@+id/editorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/promptCard" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/featureScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/editorPanel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:id="@+id/featureContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp" />

        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
