<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/textInputOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:elevation="20dp"
    android:focusable="true"
    android:visibility="gone">

    <!-- Bộ 3 công cụ ở giữa phía trên giống Facebook Story -->
    <LinearLayout
        android:id="@+id/llTextTopTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nút chọn màu -->
        <ImageButton
            android:id="@+id/btnTextColor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_spark" /> <!-- TODO: Đổi thành icon Bánh xe màu -->

        <!-- Nút bọc nền chữ (Chữ T) -->
        <ImageButton
            android:id="@+id/btnTextBackground"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_text" /> <!-- TODO: Đổi thành icon chữ T có khung -->

        <!-- Nút căn lề (Trái/Giữa/Phải) -->
        <ImageButton
            android:id="@+id/btnTextAlign"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_border" /> <!-- TODO: Đổi thành icon Căn lề -->
    </LinearLayout>

    <EditText
        android:id="@+id/etOverlayText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:background="@null"
        android:gravity="center"
        android:hint="Nhập gì đó..."
        android:inputType="textMultiLine"
        android:textColor="@android:color/white"
        android:textColorHint="#99FFFFFF"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@+id/fontScrollView"
        app:layout_constraintTop_toBottomOf="@+id/llTextTopTools" />

    <!-- Thanh chọn Font chữ ở dưới cùng -->
    <HorizontalScrollView
        android:id="@+id/fontScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fontDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Mặc định"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fontTypewriter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Đánh máy"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="In đậm"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>